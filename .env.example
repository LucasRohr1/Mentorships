# Database Configuration
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/mentorships"

# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Configuration
# Generate with: node -e "require('crypto').randomBytes(32).toString('hex') |> console.log"
JWT_SECRET=replace_with_at_least_32_character_random_string
JWT_EXPIRES_IN=7d

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
BCRYPT_SALT_ROUNDS=12

# Logging
LOG_LEVEL=info
